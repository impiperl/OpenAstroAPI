<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://www.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>


    <groupId>astroapi</groupId>
    <artifactId>astroapi</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>OpenAstroAPI</name>
    <description>Open API for astrological calculations</description>
    <licenses>
        <license>
            <name>GNU Affero General Public License v3.0 or later</name>
            <url>https://www.gnu.org/licenses/agpl-3.0.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!--
            2.7.18 ist die letzte 2.7er-Fassung und genau die, die gAIster in Produktion fährt.
            Der Sprung von 2.7.1 gehört zum Java-Upgrade: 2.7.1 bringt Spring Framework 5.3.21,
            2.7.18 bringt 5.3.31 — und erst dort sind die Reflexions- und ASM-Anpassungen für
            neuere JDKs drin. Mit 2.7.1 auf einer Temurin-21-Laufzeit wäre das Risiko unnötig.
        -->
        <version>2.7.18</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <properties>
        <!--
            Compile-Ziel 18, Laufzeit Temurin 21 — dieselbe Paarung wie gAIster, die hier in
            Produktion läuft. Bewusst NICHT Ziel 21: Spring Boot 2.7 ist offiziell bis Java 19
            freigegeben, und 18 bleibt innerhalb dieser Zusage. Die JVM führt den Bytecode
            ohnehin aus — ältere Zielversion auf neuerer Laufzeit ist der übliche, sichere Weg.

            Die Swiss-Ephemeris-Bibliothek gibt hier nichts vor: sie ist Java-8-Bytecode
            (Class-Version 52) und läuft auf jeder neueren JVM.
        -->
        <java.version>18</java.version>
        <!--
            Prueft die API-Oberflaeche gegen Java 11, nicht nur die Bytecode-Version.

            Spring Boots Elternpom setzt aus java.version nur `source` und `target`. Die beiden
            erzeugen Java-11-Bytecode, lassen aber Methoden neuerer JDKs durch: wer lokal mit
            Java 21 baut, bekommt einen gruenen Build und der Container-Build mit
            `maven:3.6.3-jdk-11` scheitert. Genau das ist am 03.10.2026 passiert —
            `Stream.toList()` (Java 16) in sechs Testzeilen, lokal gruen, im Image rot.

            `release` zieht die Standardbibliothek der Zielversion heran. Damit faellt derselbe
            Fehler lokal auf, mit welchem JDK auch immer gebaut wird.

            Die Zielversion selbst bleibt 11. Sie ist keine Vorgabe der Swiss-Ephemeris-Bibliothek
            (die ist Java-8-Bytecode und laeuft auf jeder neueren JVM), sondern die Festlegung des
            Dockerfiles. Eine Anhebung gehoert in einen eigenen Schritt zusammen mit dem Image.
        -->
        <maven.compiler.release>${java.version}</maven.compiler.release>
    </properties>
    <dependencies>
        <!-- Spring Boot Starter Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Boot Starter Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Swisseph -->
        <dependency>
            <groupId>swisseph</groupId>
            <artifactId>swisseph</artifactId>
            <version>2.00.00-01</version>
        </dependency>

        <!-- Jackson Datatype JSR310 (für Java 8 Date/Time Unterstützung) -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!-- Optional: Wenn Sie org.json verwenden -->
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>20240303</version>
        </dependency>

        <!-- Test Abhängigkeiten -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.iakovlev</groupId>
            <artifactId>timeshape</artifactId>
            <version>2024a.24</version>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
    </dependencies>


    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
